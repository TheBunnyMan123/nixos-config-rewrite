#!/usr/bin/env bash
# Rejects commits where the body exceeds 72 chars/line.

commit_msg_file="$1"
max_subject_len=50
max_len=72
line_num=0
failed=0

subject_line=$(grep -v '^#' "$commit_msg_file" | sed -n '1p')

types="feat|fix|docs|style|refactor|perf|test|chore"
subject_pattern="^(${types})(\([a-z0-9./-]+\))?!?: [a-z0-9].*[^.]$"


# Subject line check
if [ -z "$subject_line" ]; then
	printf "Commit message is empty.\n"
	failed=1
else
	if [ "${#subject_line}" -gt "$max_subject_len" ]; then
		printf "Subject line exceeds %i chars (%i chars):\n" "$max_subject_len" "${#subject_line}"
		printf "\t%s\n" "$subject_line"
		failed=1
	fi

	if ! [[ "$subject_line" =~ $subject_pattern ]]; then
		printf "Subject line doesn't match Conventional Commits format:\n"
		printf "\t%s\n" "$subject_line"
		printf "\tExpected: type(scope)!: description\n"
		printf "\t- type must be one of: %s\n" "${types//|/, }"
		printf "\t- description starts lowercase, no trailing period\n"
		failed=1
	fi
fi


# Breaking-change sync check
has_bang=0
if [[ "$subject_line" =~ ^[a-z]+(\([a-z0-9./-]+\))?!: ]]; then
	has_bang=1
fi

has_breaking_footer=0
if grep -qE '^BREAKING CHANGE: .+' "$commit_msg_file"; then
	has_breaking_footer=1
fi

if [ "$has_bang" -eq 1 ] && [ "$has_breaking_footer" -eq 0 ]; then
	printf "Subject has '!' but no 'BREAKING CHANGE:' footer was found.\n"
	printf "\tAdd a footer line: BREAKING CHANGE: <description>\n"
	failed=1
fi

if [ "$has_bang" -eq 0 ] && [ "$has_breaking_footer" -eq 1 ]; then
	printf "'BREAKING CHANGE:' footer found but subject line is missing '!'.\n"
	printf "\tAdd '!' before the colon, e.g. feat(scope)!: description\n"
	failed=1
fi


# Body check
while IFS= read -r line; do
	line_num=$((line_num + 1))

	if [ "$line_num" -eq 1 ] || [[ "$line" == \#* ]]; then
		continue
	fi

	if [[ "$line" =~ ^https?:// ]]; then
		continue
	fi

	if [ "${#line}" -gt "$max_len" ]; then
		printf "Line %i exceeds %i chars (%i):\n" "$line_num" "$max_len" "${#line}"
		printf "\t%s\n" "$line"
		failed=1
	fi
done < "$commit_msg_file"

if [ "$failed" -eq 1 ]; then
	printf "\n"
	printf "Commit message body lines must wrap at %i characters.\n" "$max_len"
	exit 1
fi

exit 0

